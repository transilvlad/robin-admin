# Robin Admin Compose settings. Compose reads this file to fill in
# docker-compose*.yaml; it is not passed to containers as a whole.
#   cp .env.example .env
# Generate secrets with: openssl rand -hex 32

# --- Every layout -----------------------------------------------------------

# Image tag of the published Robin Admin images.
ROBIN_ADMIN_VERSION=latest
# Browser-facing URL, used in emailed links. Include a path prefix when Robin
# Admin is published below one, for example https://example.test/admin.
ROBIN_ADMIN_PUBLIC_URL=https://localhost:3443
SESSION_SECRET=
# Encrypts every stored secret (agent credentials, service secrets, webhook
# URLs, relay passwords). At least 32 characters. Back it up: changing or
# losing it makes those secrets unreadable.
ROBIN_ADMIN_ENCRYPTION_KEY=
# Password of Robin Admin's database user: the bundled suite-admin-postgres in
# the standalone stack, the Robin suite's PostgreSQL with the suite overlay.
DB_PASSWORD=
# HTTPS port of the bundled gateway (suite-admin-gateway).
ADMIN_HTTPS_PORT=3443
# Path the UI is served under, with leading and trailing slashes.
BASE_PATH=/
# The UI's Content-Security-Policy: enforce, report-only or off. Leave
# CONTENT_SECURITY_POLICY empty for the default (see doc/configuration.md).
CONTENT_SECURITY_POLICY_MODE=enforce
CONTENT_SECURITY_POLICY=

# Bundled telemetry store (suite-victoriametrics). Applied when the store
# container is recreated; reducing retention deletes older samples.
TELEMETRY_RETENTION_DAYS=90
TELEMETRY_STORE_MEMORY=1g

# Pin the offline Robin Sheriff root public key (PEM with literal \n).
SHERIFF_ROOT_PUBLIC_KEY_PEM=

# Module installer (profile `installer`, or a host service). Same secret on
# both sides.
MODULE_INSTALLER_SIGNING_SECRET=

# --- Suite overlay (docker-compose.suite.yaml) --------------------------------

# Credential of the pre-provisioned co-located agent, suite-admin-agent.
SUITE_AGENT_CREDENTIAL=
# One unique secret per module backend; give each module only its own value.
MODULE_PROXY_SECRETS_JSON={"robin-tools":"","robin-qa":"","robin-sheriff":""}
# Host paths of the Robin suite checkout, when it is not ../robin.
# RSPAMD_CONFIG_MOUNT=../robin/.suite/etc/rspamd/local.d
# RSPAMD_STORE_MOUNT=../robin/store/rspamd
# ROBIN_LOG_MOUNT=../robin/log/robin
# SUITE_LOG_MOUNT=../robin/log

# --- Error reporting (optional) -------------------------------------------------
# Robin Admin's own server and UI errors go to Sentry when a DSN is set.
# SENTRY_BROWSER_DSN sends UI errors to another project (default: SENTRY_DSN).
# SENTRY_DSN=
# SENTRY_BROWSER_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.05

# --- Host-networked layout (docker-compose.host.yaml) -------------------------

# Every role address is a loopback address; override to match the host.
# DB_HOST=127.0.0.1
# DB_NAME=robin_admin
# DB_USER=robin_admin
# ADMIN_UI_PORT=3002
# TELEMETRY_STORE_PORT=8428

# --- Development overlay (docker-compose.dev.yaml) ----------------------------

# The dev overlay defaults to NODE_ENV=development and COOKIE_SECURE=false.
# Ingest key for the telemetry-dev profile (a telemetry:write API key).
TELEMETRY_DEV_API_KEY=
# Enrollment for the postfix-dev profile's agent (Fleet > Agents).
# POSTFIX_AGENT_ID=
# POSTFIX_AGENT_ENROLLMENT_TOKEN=
