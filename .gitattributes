# Normalize text files to LF in both the repository and working tree.
* text=auto eol=lf

# Application source and web assets use LF explicitly.
*.ts       text eol=lf
*.tsx      text eol=lf
*.js       text eol=lf
*.mjs      text eol=lf
*.css      text eol=lf
*.html     text eol=lf
*.svg      text eol=lf

# Configuration, documentation, and deployment files use LF explicitly.
*.json     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.md       text eol=lf
*.conf     text eol=lf
*.service  text eol=lf
.env.example text eol=lf
Dockerfile   text eol=lf
Caddyfile    text eol=lf

# Binary assets are never converted or diffed as text.
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.webp     binary
*.avif     binary

# Raw messages must retain their exact bytes for parsing and signature checks.
*.eml      -text -diff -merge !eol
